# ChainDeal — ignore rules for the whole repository.
# Principle: commit source, manifests and docs; never commit build output,
# generated artifacts, local machine state, or anything secret.

# ---------------------------------------------------------------- secrets
# Generated by `make k8s-secrets` / `make k8s-certs`: DB passwords, auth
# signing / encryption keys, seed client secret, bootstrap admin password,
# the local CA and TLS keys. Recreate them; never commit them.
deploy/k8s/.secrets/
deploy/certs/
# Safety net for secret-shaped files anywhere in the tree.
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
*.srl
.env
.env.*
!.env.example

# Demo wallets written by `make seed` contain private keys.
scripts/demo-wallets.json
frontend/public/demo-wallets.json

# ---------------------------------------------------------------- Rust
/target/
**/*.rs.bk
# Cargo.lock is intentionally committed (this workspace builds binaries).

# ---------------------------------------------------------------- frontend
node_modules/
frontend/dist/
# WASM wallet generated by `make wasm` (wasm-pack) from crates/wallet-wasm.
frontend/src/wasm/
*.tsbuildinfo
.vite/
.eslintcache
# Playwright / screenshot tooling output (the curated docs/screenshots are committed).
test-results/
playwright-report/
playwright/.cache/

# ---------------------------------------------------------------- Kubernetes
# Files the Makefile copies in before `kubectl kustomize` (e.g. init.lua).
deploy/k8s/base/.generated/
# Rendered manifests, if you dump them locally.
*.rendered.yaml

# ---------------------------------------------------------------- logs & runtime
*.log
logs/
*.pid
*.snap
*.xlog
*.vylog
coverage/
*.profraw
*.profdata

# ---------------------------------------------------------------- editors & OS
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db
# Local AI-assistant / tool configuration.
.claude/
